{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)"
  ],
  "schedule": ["before 6am on monday"],
  "separateMajorMinor": false,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"],
    "groupName": "docs toolchain"
  },
  "packageRules": [
    {
      "matchPackageNames": ["*"],
      "groupName": "docs toolchain"
    }
  ]
}
