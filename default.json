{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    ":semanticCommits",
    ":semanticCommitTypeAll(fix)"
  ],
  "schedule": ["* * * * 1"],
  "timezone": "UTC",
  "rebaseWhen": "conflicted",
  "updateNotScheduled": false,
  "separateMultipleMajor": true
}
